# Set your own private game entrance passcode before starting the server.
GAME_ACCESS_CODE=replace-with-your-passcode
# Local/LAN mode; public deployment uses deploy/.env.public.example and HTTPS.
APP_MODE=lan
# Private persistent state; never put this under public/ or dist/.
ROOM_STORE_PATH=data/rooms.sqlite
# Optional: require a working LiveKit backend at startup.
VOICE_REQUIRED=false
# Optional voice: configure all three together, or run npm run voice:local.
# LIVEKIT_URL=wss://voice.example.com
# LIVEKIT_API_KEY=replace-with-livekit-api-key
# LIVEKIT_API_SECRET=replace-with-livekit-api-secret
