GAME_DOMAIN=game.example.com
PUBLIC_ORIGIN=https://game.example.com
TLS_EMAIL=admin@example.com
# New deployments only: pick a stable name. Existing deployments MUST retain their actual project name.
# Changing this selects different networks/volumes and can appear to lose existing rooms.
COMPOSE_PROJECT_NAME=avalon
# Relative to deploy/compose.yaml; must be the same file passed to --env-file.
GAME_ENV_FILE=.env.public
# Tag each tested build for upgrades/rollback; never overwrite the previous release tag.
GAME_IMAGE=avalon:local
# Loopback-only app port for the machine's existing Caddy (not a public port).
GAME_HTTP_PORT=3100
# Adjust all four together if this subnet conflicts with another Docker/VPN network.
GAME_NETWORK_SUBNET=172.30.70.0/24
GAME_NETWORK_GATEWAY=172.30.70.1
GAME_CADDY_IP=172.30.70.2
GAME_APP_IP=172.30.70.3
# Use a randomly generated private value of at least 16 characters, not a short PIN.
GAME_ACCESS_CODE=replace-with-a-random-private-passcode
ROOM_STORE_PATH=/app/data/rooms.sqlite
VOICE_REQUIRED=false
# Live voice is optional. Leave all LIVEKIT values unset for the base game.
# For voice, configure managed LiveKit or a secured self-hosted server with TURN/TLS.
# LIVEKIT_URL=wss://voice.example.com
# LIVEKIT_API_URL=https://voice.example.com
# LIVEKIT_API_KEY=replace-with-livekit-api-key
# LIVEKIT_API_SECRET=replace-with-a-random-livekit-secret-of-at-least-32-characters
