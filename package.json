{
  "name": "avalon",
  "version": "1.0.0",
  "description": "Server-authoritative multiplayer Avalon with persistent rooms and optional voice chat.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cailishy/avalon.git"
  },
  "homepage": "https://github.com/cailishy/avalon#readme",
  "bugs": {
    "url": "https://github.com/cailishy/avalon/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets": "node scripts/media/download-assets.mjs",
    "dev": "tsx src/server/index.ts --dev",
    "build": "vite build && node scripts/build/build-server.mjs",
    "build:server": "node scripts/build/build-server.mjs",
    "build:e2e": "node scripts/build/build-e2e.mjs",
    "test:e2e": "playwright test",
    "start": "node dist-server/server/index.js",
    "start:public": "node scripts/deploy/start-public.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "repo:check": "node scripts/checks/check-repository.mjs",
    "docs:check": "node scripts/checks/check-docs.mjs",
    "source:export": "node scripts/checks/export-source.mjs",
    "release:check": "node scripts/checks/check-repository.mjs --release",
    "audit:secrets": "node scripts/checks/check-secrets.mjs",
    "deploy:init": "node --import tsx scripts/deploy/deployment.mjs init",
    "deploy:check": "node --import tsx scripts/deploy/deployment.mjs check",
    "deploy:caddy": "node --import tsx scripts/deploy/deployment.mjs caddy",
    "check": "npm run repo:check && npm run docs:check && npm run lint && npm run typecheck && npm test",
    "voice:local": "node scripts/deploy/setup-voice-local.mjs",
    "voice:verify": "node --import tsx scripts/verify/verify-voice.mjs",
    "recovery:verify": "node scripts/verify/verify-recovery.mjs",
    "narration:script": "node --import tsx scripts/media/narration.ts --export",
    "narration:verify": "node --import tsx scripts/media/narration.ts --verify",
    "narration:publish": "node --import tsx scripts/media/narration.ts --publish",
    "gateway:verify": "node --import tsx scripts/verify/verify-gateway.mjs"
  },
  "dependencies": {
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "livekit-client": "^2.22.4",
    "livekit-server-sdk": "^2.19.1",
    "lucide": "^1.56.0",
    "morphdom": "^2.7.8",
    "proxy-addr": "^2.0.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@livekit/rtc-node": "^1.1.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/proxy-addr": "^2.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
